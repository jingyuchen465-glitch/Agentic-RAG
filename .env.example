# ==================== 应用基础配置 ====================
# 运行环境: development / production
APP_ENV=development
# API 路由版本前缀
API_V1_PREFIX=/api/v1

# ==================== 文件上传 ====================
# 上传文件的存储目录
UPLOAD_DIR=./data/uploads
# 单次上传文件大小上限 (MB)
MAX_UPLOAD_SIZE_MB=20

# ==================== 数据存储 (MySQL / Redis) ====================
# 业务元数据数据库 (MySQL)
DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/agentic_rag?charset=utf8mb4
# 缓存与会话存储 (Redis)
REDIS_URL=redis://127.0.0.1:6379/0

# ==================== Milvus 向量数据库 ====================
# Milvus 服务地址 (支持 http 与 grpc 两种协议)
MILVUS_URI=http://127.0.0.1:19530
# Milvus 认证令牌 (未启用鉴权时留空)
MILVUS_TOKEN=
# Milvus 数据库名 (多库场景; 连接时通过 db_name 指定)
MILVUS_DATABASE=default
# 知识库文档向量集合名
MILVUS_KNOWLEDGE_COLLECTION=knowledge_chunks
# 工具注册向量集合名
MILVUS_TOOL_COLLECTION=tool_registry

# ==================== LLM 服务 (OpenAI 兼容接口) ====================
# API 密钥
OPENAI_API_KEY=sk-xxxx
# 接口基础地址 (可切换为代理或兼容网关，如阿里云百炼)
OPENAI_BASE_URL=
# 对话/推理模型
OPENAI_CHAT_MODEL=gpt-4.1-mini
# 向量化 (Embedding) 模型
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 多模态视觉模型（PDF 图片描述，走 OPENAI_BASE_URL 兼容网关）
VISION_MODEL=qwen-vl-plus

# ==================== 阿里云 OSS（PDF 图片存储） ====================
# AccessKey ID / Secret
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Bucket 名称与 Endpoint
OSS_BUCKET=
OSS_ENDPOINT=
# 公网访问前缀（用于拼接图片 URL）
OSS_PUBLIC_BASE_URL=

# ==================== 网络搜索服务 ====================
# Tavily 搜索 API 密钥
TAVILY_API_KEY=tvly-xxxx

# ==================== MCP 中台（接口调用工具） ====================
# MCP 中台 Streamable HTTP 端点（无需带 /mcp 后缀，也可填写完整地址）
MCP_BASE_URL=http://localhost:8090
# MCP 鉴权 Bearer Token
MCP_TOKEN=mcp_dev_token

# ==================== RAG 检索与工具路由 ====================
# 单次检索返回的文档条数
RETRIEVAL_TOP_K=8
# 工具路由语义相似度阈值 (低于该值视为不确定)
ROUTER_THRESHOLD=0.62
# 路由结果歧义判定差值 (候选分数差小于该值视为歧义)
ROUTER_AMBIGUITY_DELTA=0.05
# Agent 执行失败后的最大重试次数
MAX_AGENT_RETRIES=2

# ==================== PDF 切分参数 ====================
# 目标块大小 / 重叠 / 固定长度兜底阈值
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_CHUNK_SIZE=2000
PDF_OCR_LANGUAGE=ch
PDF_RENDER_DPI=144
PDF_CONCURRENCY=4

# ==================== 会话管理 ====================
# 会话缓存有效期 (秒)
SESSION_TTL_SECONDS=3600
